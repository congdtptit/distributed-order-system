{
  "permissions": {
    "allow": [
      "Bash(docker compose exec tools pytest *)",
      "Bash(docker compose exec tools ruff *)",
      "Bash(docker compose exec tools pyright *)",
      "Bash(docker compose exec tools python scripts/create_topics.py)",
      "Bash(docker compose exec tools python scripts/check_invariants.py *)",
      "Bash(docker compose exec frontend npx --no-install tsc *)",
      "Bash(docker compose exec frontend npx --no-install vitest *)",
      "Bash(docker compose exec frontend npx --no-install biome *)",
      "Bash(docker compose ps *)",
      "Bash(docker compose logs *)",
      "Bash(docker compose up *)",
      "Bash(bin/chaos status)",
      "Bash(python3 .claude/skills/doc-check/scripts/check_docs.py)",
      "Bash(python3 .claude/skills/ui-ux-pro-max/scripts/search.py *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/.env)",
      "Read(./**/.env.*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/phase-guard.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/code-guard.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/format.sh",
            "timeout": 60
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/docs-check.sh",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/test-gate.sh",
            "timeout": 600
          }
        ]
      }
    ]
  }
}
