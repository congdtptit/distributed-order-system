#!/bin/bash
# Inject the faults the tier 3 scenarios need into the running compose cluster.
# Section 3 of docs/03-implementation-plan.md says which scenario uses which.
#
#   bin/chaos offline <branch>          cut a branch service off Kafka; it keeps its DB and API
#   bin/chaos online <branch>           reconnect it
#   bin/chaos stop <container>          stop a broker or a service (kafka2, kitchen, inventory-1…)
#   bin/chaos start <container>         start it again
#   bin/chaos cut-replication <branch>  cut a branch DB off the Central Order Replica
#   bin/chaos restore-replication <branch>
#   bin/chaos status                    which containers run and which networks each branch has
#
# <branch> is pos01, pos02 or online.
set -euo pipefail
cd "$(dirname "$0")/.."

project=order-system
# --profile full so that the containers of that profile can be named too.
compose=(docker compose --profile full)
container() { "${compose[@]}" ps -q "$1"; }
need() {
  local id
  id=$(container "$1")
  [ -n "$id" ] || { echo "$1 is not running (pos02, online and inventory-2 need: docker compose --profile full up -d)" >&2; exit 1; }
  echo "$id"
}
branch() {
  case "${1:-}" in
    pos01|pos02|online) echo "$1" ;;
    *) echo "branch must be pos01, pos02 or online, got '${1:-}'" >&2; exit 2 ;;
  esac
}

case "${1:-}" in
  offline)
    b=$(branch "${2:-}")
    docker network disconnect "${project}_kafka-net" "$(need "$b")"
    echo "$b is cut off Kafka; its DB and http API still work" ;;
  online)
    b=$(branch "${2:-}")
    # --alias: a plain connect drops the service name Compose gave the container on that network.
    docker network connect --alias "$b" "${project}_kafka-net" "$(need "$b")"
    echo "$b is back on Kafka" ;;
  stop)
    "${compose[@]}" stop "${2:?container name}" ;;
  start)
    "${compose[@]}" start "${2:?container name}" ;;
  cut-replication)
    b=$(branch "${2:-}")
    docker network disconnect "${project}_replication-net" "$(need "$b-db")"
    echo "$b-db no longer replicates to central-db" ;;
  restore-replication)
    b=$(branch "${2:-}")
    # The central DB finds the branch DB by its service name, so the alias must come back.
    docker network connect --alias "$b-db" "${project}_replication-net" "$(need "$b-db")"
    echo "$b-db replicates to central-db again" ;;
  status)
    "${compose[@]}" ps --format 'table {{.Service}}\t{{.State}}\t{{.Status}}'
    for b in pos01 pos02 online; do
      id=$(container "$b")
      [ -n "$id" ] || continue
      nets=$(docker inspect -f '{{range $k, $v := .NetworkSettings.Networks}}{{$k}} {{end}}' "$id" | sed "s/${project}_//g")
      echo "$b networks: $nets"
    done ;;
  *)
    sed -n '2,13p' "$0" | sed 's/^# \{0,1\}//'
    exit 2 ;;
esac
