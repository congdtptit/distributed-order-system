{
  "name": "distributed-order-system (Python)",
  "dockerComposeFile": ["../infra/compose.yaml"],
  "service": "backend-dev",
  "runServices": ["backend-dev", "frontend-dev"],
  "workspaceFolder": "/workspace",
  "customizations": {
    "vscode": {
      "settings": {
        "python.defaultInterpreterPath": "/opt/venv/bin/python"
      },
      "extensions": ["ms-python.python", "charliermarsh.ruff", "biomejs.biome"]
    }
  }
}
