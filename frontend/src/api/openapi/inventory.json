{
  "components": {
    "schemas": {
      "Alert": {
        "description": "A Flow D item a person needs to look at (the ``alerts`` table, section 3 of\ndocs/02-detailed-design.md).",
        "properties": {
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "detail": {
            "additionalProperties": true,
            "title": "Detail",
            "type": "object"
          },
          "event_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Event Id"
          },
          "id": {
            "title": "Id",
            "type": "integer"
          },
          "kind": {
            "title": "Kind",
            "type": "string"
          },
          "order_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Order Id"
          },
          "source_offset": {
            "title": "Source Offset",
            "type": "integer"
          },
          "source_partition": {
            "title": "Source Partition",
            "type": "integer"
          },
          "source_topic": {
            "title": "Source Topic",
            "type": "string"
          }
        },
        "required": [
          "id",
          "kind",
          "order_id",
          "event_id",
          "source_topic",
          "source_partition",
          "source_offset",
          "detail",
          "created_at"
        ],
        "title": "Alert",
        "type": "object"
      },
      "ClearCheck": {
        "properties": {
          "counted_on_hand": {
            "anyOf": [
              {
                "minimum": 0.0,
                "type": "number"
              },
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Counted On Hand"
          }
        },
        "title": "ClearCheck",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "Monitor": {
        "properties": {
          "consumer_group": {
            "title": "Consumer Group",
            "type": "string"
          },
          "kafka_reachable": {
            "title": "Kafka Reachable",
            "type": "boolean"
          },
          "slow_after_s": {
            "title": "Slow After S",
            "type": "integer"
          },
          "topics": {
            "items": {
              "$ref": "#/components/schemas/TopicState"
            },
            "title": "Topics",
            "type": "array"
          }
        },
        "required": [
          "consumer_group",
          "slow_after_s",
          "kafka_reachable",
          "topics"
        ],
        "title": "Monitor",
        "type": "object"
      },
      "Receipt": {
        "properties": {
          "ingredient_id": {
            "title": "Ingredient Id",
            "type": "string"
          },
          "quantity": {
            "anyOf": [
              {
                "exclusiveMinimum": 0.0,
                "type": "number"
              },
              {
                "type": "string"
              }
            ],
            "title": "Quantity"
          }
        },
        "required": [
          "ingredient_id",
          "quantity"
        ],
        "title": "Receipt",
        "type": "object"
      },
      "StockItem": {
        "description": "The four quantities of section 3.3 of the specification and the stock-check flag.",
        "properties": {
          "available": {
            "title": "Available",
            "type": "string"
          },
          "consumed": {
            "title": "Consumed",
            "type": "string"
          },
          "ingredient_id": {
            "title": "Ingredient Id",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "needs_check": {
            "title": "Needs Check",
            "type": "boolean"
          },
          "reserved": {
            "title": "Reserved",
            "type": "string"
          },
          "unit": {
            "title": "Unit",
            "type": "string"
          },
          "wasted": {
            "title": "Wasted",
            "type": "string"
          }
        },
        "required": [
          "ingredient_id",
          "name",
          "unit",
          "available",
          "reserved",
          "consumed",
          "wasted",
          "needs_check"
        ],
        "title": "StockItem",
        "type": "object"
      },
      "TopicState": {
        "properties": {
          "oldest_unread_age_s": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Oldest Unread Age S"
          },
          "oldest_unread_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Oldest Unread At"
          },
          "slow": {
            "title": "Slow",
            "type": "boolean"
          },
          "topic": {
            "title": "Topic",
            "type": "string"
          },
          "unread": {
            "title": "Unread",
            "type": "integer"
          }
        },
        "required": [
          "topic",
          "unread",
          "oldest_unread_at",
          "oldest_unread_age_s",
          "slow"
        ],
        "title": "TopicState",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Inventory",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/alerts": {
      "get": {
        "description": "Orders that need review and unmatched commands,\nnewest first (at most 100); ``kind`` filters.",
        "operationId": "alerts_alerts_get",
        "parameters": [
          {
            "in": "query",
            "name": "kind",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "enum": [
                    "CAN_KIEM_TRA",
                    "LENH_KHONG_KHOP"
                  ],
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Kind"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/Alert"
                  },
                  "title": "Response Alerts Alerts Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Alerts"
      }
    },
    "/health": {
      "get": {
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Health Health Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health"
      }
    },
    "/ingredients/{ingredient_id}/clear-check": {
      "post": {
        "description": "Clear the stock-check flag once the check is done (Flow A, scenario 48).",
        "operationId": "clear_stock_check_ingredients__ingredient_id__clear_check_post",
        "parameters": [
          {
            "in": "path",
            "name": "ingredient_id",
            "required": true,
            "schema": {
              "title": "Ingredient Id",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "anyOf": [
                  {
                    "$ref": "#/components/schemas/ClearCheck"
                  },
                  {
                    "type": "null"
                  }
                ],
                "title": "Body"
              }
            }
          }
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StockItem"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "description": "No such ingredient"
          },
          "409": {
            "description": "counted_on_hand is less than the reserved quantity"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Clear Stock Check"
      }
    },
    "/monitor": {
      "get": {
        "description": "Flow D: unread messages per topic and the slow-consumer alert.",
        "operationId": "monitor_monitor_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Monitor"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Monitor"
      }
    },
    "/stock": {
      "get": {
        "description": "Testing, the demo, and Flow D's list of ingredients awaiting a stock check.",
        "operationId": "list_stock_stock_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/StockItem"
                  },
                  "title": "Response List Stock Stock Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "List Stock"
      }
    },
    "/stock/receipts": {
      "post": {
        "description": "Stock receipt: adds to available stock. Phase 2 adds the dish-status computation.",
        "operationId": "stock_receipt_stock_receipts_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Receipt"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StockItem"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "description": "No such ingredient"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Stock Receipt"
      }
    }
  }
}
