{
  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "Rejection": {
        "properties": {
          "reason_code": {
            "title": "Reason Code",
            "type": "string"
          },
          "spoiled_ingredients": {
            "default": [],
            "items": {
              "type": "string"
            },
            "title": "Spoiled Ingredients",
            "type": "array"
          }
        },
        "required": [
          "reason_code"
        ],
        "title": "Rejection",
        "type": "object"
      },
      "ReservedLine": {
        "properties": {
          "ingredient_id": {
            "title": "Ingredient Id",
            "type": "string"
          },
          "name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Name"
          },
          "quantity": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Quantity"
          },
          "unit": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Unit"
          }
        },
        "required": [
          "ingredient_id"
        ],
        "title": "ReservedLine",
        "type": "object"
      },
      "Ticket": {
        "properties": {
          "items": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "title": "Items",
            "type": "array"
          },
          "order_created_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Order Created At"
          },
          "order_id": {
            "title": "Order Id",
            "type": "string"
          },
          "origin_branch": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Origin Branch"
          },
          "reserved": {
            "items": {
              "$ref": "#/components/schemas/ReservedLine"
            },
            "title": "Reserved",
            "type": "array"
          },
          "status": {
            "title": "Status",
            "type": "string"
          },
          "warnings": {
            "items": {
              "type": "string"
            },
            "title": "Warnings",
            "type": "array"
          }
        },
        "required": [
          "order_id",
          "status",
          "origin_branch",
          "order_created_at",
          "items",
          "reserved",
          "warnings"
        ],
        "title": "Ticket",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Kitchen",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/health": {
      "get": {
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Health Health Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health"
      }
    },
    "/tickets": {
      "get": {
        "operationId": "tickets_tickets_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/Ticket"
                  },
                  "title": "Response Tickets Tickets Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Tickets"
      }
    },
    "/tickets/{order_id}/complete": {
      "post": {
        "description": "Cooking \u2192 Completed; emits OrderCompleted.",
        "operationId": "complete_ticket_tickets__order_id__complete_post",
        "parameters": [
          {
            "in": "path",
            "name": "order_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Order Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Ticket"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "description": "No ticket for this order"
          },
          "409": {
            "description": "The ticket is no longer in the required status (a lost race)"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Complete Ticket"
      }
    },
    "/tickets/{order_id}/reject": {
      "post": {
        "description": "Queued \u2192 Cancelled (Kitchen rejection); emits OrderCancelled and ReleaseRequested.",
        "operationId": "reject_ticket_tickets__order_id__reject_post",
        "parameters": [
          {
            "in": "path",
            "name": "order_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Order Id",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Rejection"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Ticket"
                }
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "description": "Bad reason or spoiled ingredients"
          },
          "404": {
            "description": "No ticket for this order"
          },
          "409": {
            "description": "The ticket is no longer in the required status (a lost race)"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Reject Ticket"
      }
    },
    "/tickets/{order_id}/start": {
      "post": {
        "description": "Queued \u2192 Cooking; emits StockConsumed.",
        "operationId": "start_tickets__order_id__start_post",
        "parameters": [
          {
            "in": "path",
            "name": "order_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Order Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Ticket"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "description": "No ticket for this order"
          },
          "409": {
            "description": "The ticket is no longer in the required status (a lost race)"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Start"
      }
    }
  }
}
